# ==========================================
# UmaEdge — Environment Variables
# ==========================================

# Database (SQLite)
DATABASE_URL=sqlite:///horsebet.db

# Scraper
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# LLM
GOOGLE_API_KEY=your_gemini_api_key_here

# Notifications (optional — configure at least one)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_TOKEN=
LINE_USER_ID=
WHATSAPP_PHONE=         # International format, e.g. +819012345678
WHATSAPP_API_KEY=       # Get from CallMeBot (see notifications/whatsapp.py)

# Deployment
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=8000
